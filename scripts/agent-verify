#!/usr/bin/env bash
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 2
check() {
  case $1 in
    *.sh) bash -n "$1" ;;
    *.json) jq -en '[inputs] | length == 1' "$1" >/dev/null ;;
    *) true ;;
  esac
}
if (($#)); then
  [[ -f $1 ]] || exit 0
  check "$1"
  exit $?
fi
fail=0
while IFS= read -r f; do
  check "$f" || fail=1
done < <(git ls-files '*.sh' '*.json')
exit "$fail"

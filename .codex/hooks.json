{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/play-notification.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "$HOME/.claude/play-notification.sh",
            "type": "command"
          }
        ],
        "matcher": "request_user_input"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash $HOME/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/play-notification.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.claude/agent-gate.sh",
            "timeout": 300,
            "type": "command"
          }
        ]
      }
    ]
  }
}
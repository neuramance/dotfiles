<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.neuramance.agent-sounds</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>read -r -t 2 -n 8 s; case "$s" in Purr|Funk) echo ok; exec /usr/bin/afplay -v 1.8 "/System/Library/Sounds/$s.aiff" &lt;/dev/null &gt;/dev/null 2&gt;&amp;1;; esac</string>
	</array>
	<key>inetdCompatibility</key>
	<dict>
		<key>Wait</key>
		<false/>
	</dict>
	<key>Sockets</key>
	<dict>
		<key>Listener</key>
		<dict>
			<key>SockNodeName</key>
			<string>127.0.0.1</string>
			<key>SockServiceName</key>
			<string>47123</string>
		</dict>
	</dict>
</dict>
</plist>

[Unit]
Description=pdash dashboard: next dev with hot reload on 127.0.0.1:3030

[Service]
Type=simple
WorkingDirectory=%h/code/pdash
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/mise/shims/pnpm dev
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target

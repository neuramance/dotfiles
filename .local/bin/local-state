#!/usr/bin/env bash
set -euo pipefail

usage='usage: local-state backup | local-state restore <host>'
account=my.1password.com
op_timeout_seconds=120
paths=(.ssh .aws/config .aws/credentials .gitconfig.local .zsh_aliases.local .zsh_secrets)
archive=$(mktemp)
trap 'rm -f "$archive"' EXIT

op() {
  perl -e '
    my ($seconds, @command) = @ARGV;
    my $pid = fork // die "local-state: fork: $!\n";
    if ($pid == 0) { exec { $command[0] } @command or die "local-state: $command[0]: $!\n" }
    $SIG{ALRM} = sub { kill "TERM", $pid; die "local-state: $command[0] timed out after ${seconds}s\n" };
    alarm $seconds;
    waitpid $pid, 0;
    exit($? ? ($? >> 8 || 1) : 0);
  ' "$op_timeout_seconds" op "$@"
}

backup() {
  local name existing=() path id store
  name=local-state-$(scutil --get LocalHostName)
  for path in "${paths[@]}"; do
    if [[ -e $HOME/$path ]]; then
      existing+=("$path")
    fi
  done
  if ((${#existing[@]} == 0)); then
    echo "local-state: nothing to back up" >&2
    exit 1
  fi
  COPYFILE_DISABLE=1 tar -C "$HOME" --exclude .ssh/agent -chvf "$archive" "${existing[@]}"
  id=$(op item list --categories Document --account "$account" --format json |
    jq -r --arg name "$name" '[.[] | select(.title == $name) | .id] | if length > 1 then error("more than one item is named \($name)") else .[0] // "" end')
  store=(op document create "$archive" --title "$name")
  if [[ -n $id ]]; then
    store=(op document edit "$id" "$archive")
  fi
  "${store[@]}" --file-name "$name.tar" --account "$account" >/dev/null
}

restore() {
  local name=local-state-$1 conflicts=() entry target
  op document get "$name" --account "$account" --out-file "$archive" --force >/dev/null
  while IFS= read -r entry; do
    target=$HOME/${entry%/}
    if [[ $entry == */ && -d $target && ! -L $target ]]; then
      continue
    fi
    if [[ -e $target || -L $target ]]; then
      conflicts+=("${entry%/}")
    fi
  done < <(tar -tf "$archive")
  if ((${#conflicts[@]})); then
    printf 'local-state: refusing to overwrite ~/%s\n' "${conflicts[@]}" >&2
    exit 1
  fi
  tar -C "$HOME" -xvf "$archive"
}

case "$#:${1-}" in
  1:backup) backup ;;
  2:restore) restore "$2" ;;
  *)
    echo "$usage" >&2
    exit 2
    ;;
esac
